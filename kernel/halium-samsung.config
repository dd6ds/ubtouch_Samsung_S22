# Halium / Ubuntu Touch fragment for the Samsung s5e9925 (Exynos 2200) kernel.
# Merged after s5e9925_defconfig + <device>.config:
#   make s5e9925_defconfig r0s.config halium-samsung.config
# scripts/check-config.sh verifies every line below ended up in the final .config.

# --- UBports generic GKI 5.10 halium.config ----------------------------------
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_NULL_TTY=y
CONFIG_DEVTMPFS=y
CONFIG_BT_HCIVHCI=y

# --- systemd / Ubuntu userspace (all off in s5e9925_defconfig) ------------------
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# --- already set in the defconfig; pinned so a tree update can't drop them --------
CONFIG_ANDROID_BINDERFS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_TUN=y
CONFIG_VETH=y

# --- tag the build so `uname -r` shows it's ours ---------------------------------
CONFIG_LOCALVERSION="-halium"

# --- firmware: Samsung enables the user-helper fallback, which makes every
# firmware request that happens before /vendor is mounted (first-stage modules
# in the Halium initramfs) wait 60 s for a helper that never comes. Direct
# loading via firmware_class.path=/vendor/firmware (cmdline) is used instead.
CONFIG_FW_LOADER_USER_HELPER=y
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
